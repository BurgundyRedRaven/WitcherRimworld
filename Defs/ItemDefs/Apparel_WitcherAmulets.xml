<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef Name="WitcherAmuletBase" ParentName="ApparelBase" Abstract="True">
        <techLevel>Medieval</techLevel>
        <thingClass>Apparel</thingClass>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponMelee/Mace</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <Mass>0.2</Mass>
            <WorkToMake>5000</WorkToMake>
        </statBases>
        <apparel>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <bodyPartGroups>
                <li>Neck</li>
            </bodyPartGroups>
            <layers>
                <li>WitcherAmuletLayer</li>
            </layers>
        </apparel>
    </ThingDef>

    <!-- Wolf Amulets -->
    <ThingDef ParentName="WitcherAmuletBase">
        <defName>Witcher_WolfAmulet_Dormant</defName>
        <label>dormant wolf amulet</label>
        <description>A silver wolf medallion. It requires the Trial of the Mountain to awaken its magical properties.</description>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>20</costStuffCount>
        <costList>
            <Silver>30</Silver>
        </costList>
        <smeltable>true</smeltable>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <researchPrerequisite>Research_WolfSchoolGear</researchPrerequisite>
        </recipeMaker>
        <comps Inherit="False">
            <li Class="CompProperties_Forbiddable" />
            <li Class="WitcherTrials.CompProperties_TriggerTrialQuest">
                <sitePartDef>SitePart_WolfTrial</sitePartDef>
                <schoolName>Wolf School</schoolName>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="WitcherAmuletBase">
        <defName>Witcher_WolfAmulet_Active</defName>
        <label>active wolf amulet</label>
        <smeltable>false</smeltable>
        <description>A vibrating silver wolf medallion. It heightens the wearer's senses and resonates with psychic energy.</description>
        <equippedStatOffsets>
            <MeleeDodgeChance>10</MeleeDodgeChance>
            <MeleeHitChance>2</MeleeHitChance>
            <HuntingStealth>0.20</HuntingStealth>
            <PsychicSensitivity>0.25</PsychicSensitivity>
        </equippedStatOffsets>
        <comps Inherit="False">
            <li Class="CompProperties_Forbiddable" />
            <li Class="WitcherTrials.CompProperties_WitcherSet">
                <setTag>WolfSet</setTag>
                <setHediff>WitcherSetBonus_Wolf</setHediff>
                <requiredPieces>3</requiredPieces>
            </li>
        </comps>
    </ThingDef>

