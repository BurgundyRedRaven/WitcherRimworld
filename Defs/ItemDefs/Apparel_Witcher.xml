<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef Name="WitcherArmorBase" ParentName="ApparelMakeableBase" Abstract="True">
        <techLevel>Medieval</techLevel>
        <tickerType>Normal</tickerType>
        <thingClass>Apparel</thingClass>
    </ThingDef>

    <!-- Wolf Armor -->
    <ThingDef ParentName="WitcherArmorBase">
        <defName>Witcher_WolfArmor</defName>
        <label>wolf school armor</label>
        <description>Medium armor offering a balanced blend of mobility and protection.</description>
        <graphicData>
            <texPath>Things/Pawn/Armor/WitcherTraining</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <thingCategories>
            <li>ApparelArmor</li>
        </thingCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawn/Armor/WitcherTraining</wornGraphicPath>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <tags>
                <li>MedievalMilitary</li>
            </tags>
            <defaultOutfitTags>
                <li>Anything</li>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
        <statBases>
            <Mass>7.0</Mass>
            <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <Insulation_Cold>15</Insulation_Cold>
            <Insulation_Heat>5</Insulation_Heat>
            <WorkToMake>25000</WorkToMake>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>120</costStuffCount>
        <costList>
            <Witcher_Mutagen>2</Witcher_Mutagen>
        </costList>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <researchPrerequisite>Research_WolfSchoolGear</researchPrerequisite>
        </recipeMaker>
        <comps>
            <li Class="WitcherTrials.CompProperties_WitcherSet">
                <setTag>WolfSet</setTag>
                <setHediff>WitcherSetBonus_Wolf</setHediff>
                <requiredPieces>3</requiredPieces>
            </li>
        </comps>
    </ThingDef>

