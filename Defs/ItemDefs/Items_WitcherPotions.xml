    <!-- White Raffard's Decoction -->
    <ThingDef ParentName="WitcherPotionBase">
        <defName>WitcherPotion_WhiteRaffard</defName>
        <label>white raffard's decoction</label>
        <description>A highly toxic mixture that forces cellular binding, causing massive immediate healing over a very short duration. Deadly for non-mutants.</description>
        <graphicData>
            <texPath>Things/Item/Drug/GoJuice/GoJuice_a</texPath>
            <color>(255, 50, 50)</color>
        </graphicData>
        <ingestible>
