<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="DrugBase" Name="WitcherPotionBase" Abstract="True">
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <WorkToMake>600</WorkToMake>
            <MarketValue>40</MarketValue>
            <Mass>0.1</Mass>
        </statBases>
        <ingestible>
            <foodType>Fluid, Processed</foodType>
            <baseIngestTicks>120</baseIngestTicks>
            <drugCategory>Medical</drugCategory>
        </ingestible>
        <comps>
            <li Class="CompProperties_Drug">
                <listOrder>1000</listOrder>
            </li>
        </comps>
    </ThingDef>

    <!-- Swallow -->
    <ThingDef ParentName="WitcherPotionBase">
        <defName>WitcherPotion_Swallow</defName>
        <label>swallow potion</label>
        <description>A highly toxic alchemical mixture that drastically accelerates the body's natural healing process.</description>
        <graphicData>
            <texPath>Things/Item/Drug/Penoxycyline/Penoxycyline_a</texPath>
            <color>(200, 50, 50)</color>
        </graphicData>
        <ingestible>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>WitcherPotion_SwallowEffect</hediffDef>
                    <severity>1.0</severity>
                </li>
                <li Class="WitcherTrials.IngestionOutcomeDoer_ToxicPotion">
                    <severity>0.50</severity>
                </li>
            </outcomeDoers>
        </ingestible>
    </ThingDef>

    <!-- Thunderbolt -->
    <ThingDef ParentName="WitcherPotionBase">
        <defName>WitcherPotion_Thunderbolt</defName>
        <label>thunderbolt potion</label>
        <description>A highly toxic mixture that temporarily sends the user's muscular and nervous system into overdrive, enhancing melee combat.</description>
        <graphicData>
            <texPath>Things/Item/Drug/GoJuice/GoJuice_a</texPath>
            <color>(50, 200, 50)</color>
        </graphicData>
        <ingestible>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>WitcherPotion_ThunderboltEffect</hediffDef>
