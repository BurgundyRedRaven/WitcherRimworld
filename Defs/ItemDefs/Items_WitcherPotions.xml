        </ingestible>
    </ThingDef>

    <!-- White Honey -->
    <ThingDef ParentName="WitcherPotionBase">
        <defName>WitcherPotion_WhiteHoney</defName>
        <label>white honey</label>
        <description>A biological cleanser that instantly purges the bloodstream of toxic buildup and completely neutralizes all active witcher potion effects.</description>
        <graphicData>
            <texPath>Things/Item/Drug/Penoxycyline/Penoxycyline_a</texPath>
            <color>(255, 255, 255)</color>
        </graphicData>
        <ingestible>
            <outcomeDoers>
                <li Class="WitcherTrials.IngestionOutcomeDoer_WhiteHoney" />
