<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Wolf School (Swords) -->
    <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
        <defName>Witcher_WolfSteelSword</defName>
        <label>wolf steel sword</label>
        <description>A masterfully crafted steel sword, optimized for fighting humans and armored targets.</description>
        <techLevel>Medieval</techLevel>
        <graphicData>
            <texPath>Things/Item/Weapons/SteelSword</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.3</drawSize>
        </graphicData>
        <statBases>
            <Mass>2.0</Mass>
            <WorkToMake>15000</WorkToMake>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>75</costStuffCount>
        <costList>
            <Witcher_Mutagen>1</Witcher_Mutagen>
        </costList>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
            <researchPrerequisite>Research_WolfSchoolGear</researchPrerequisite>
        </recipeMaker>
        <tools>
            <li>
                <label>handle</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2.0</cooldownTime>
            </li>
            <li>
                <label>point</label>
                <capacities>
                    <li>Stab</li>
                </capacities>
                <power>18</power>
                <cooldownTime>2.4</cooldownTime>
            </li>
            <li>
                <label>edge</label>
                <capacities>
                    <li>Cut</li>
                </capacities>
                <power>20</power>
                <cooldownTime>2.4</cooldownTime>
            </li>
        </tools>
        <modExtensions>
            <li Class="WitcherTrials.ModExtension_WitcherWeapon">
                <isSteel>true</isSteel>
                <damageMultiplier>1.5</damageMultiplier>
            </li>
        </modExtensions>
    </ThingDef>

