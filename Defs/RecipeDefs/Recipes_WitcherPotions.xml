<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <RecipeDef Name="WitcherPotionRecipeBase" Abstract="True">
        <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
        <workAmount>600</workAmount>
        <recipeUsers>
            <li>DrugLab</li>
        </recipeUsers>
        <skillRequirements>
            <Intellectual>6</Intellectual>
            <Medicine>4</Medicine>
        </skillRequirements>
    </RecipeDef>

    <RecipeDef ParentName="WitcherPotionRecipeBase">
        <defName>Make_WitcherPotion_Swallow</defName>
        <label>brew swallow potion</label>
        <description>Brew the Swallow potion.</description>
        <jobString>Brewing swallow potion.</jobString>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Witcher_Mutagen</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>MedicineHerbal</li>
                <li>Witcher_Mutagen</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <WitcherPotion_Swallow>1</WitcherPotion_Swallow>
        </products>
        <researchPrerequisite>Research_BasicWitcherPotions</researchPrerequisite>
    </RecipeDef>

