<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Wolf School Site & GenStep -->
    <SitePartDef>
        <defName>SitePart_WolfTrial</defName>
        <label>trial of the mountain (wolf)</label>
        <description>A remote region claimed by a highly aggressive pack of apex predators.</description>
        <workerClass>SitePartWorker</workerClass>
        <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
        <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
        <forceExitAndRemoveMapCountdownDurationDays>3</forceExitAndRemoveMapCountdownDurationDays>
    </SitePartDef>

    <GenStepDef>
        <defName>GenStep_WolfTrial</defName>
        <order>450</order>
        <genStep Class="WitcherTrials.GenStep_WolfTrial" />
        <linkWithSite>SitePart_WolfTrial</linkWithSite>
    </GenStepDef>

