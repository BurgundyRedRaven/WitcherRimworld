<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Trial of the Grasses  -->
  <HediffDef>
    <defName>Witcher_GrassesSickness</defName>
    <label>Trial of the Grasses</label>
    <description>The body is violently reacting to the alchemical mutagens. Requires constant medical tending.</description>
    <hediffClass>WitcherTrials.Hediff_TrialOfTheGrasses</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 0.3)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.20</severityPerDayNotImmune>
        <immunityPerDaySick>0.15</immunityPerDaySick>
        <severityPerDayImmune>-0.2</severityPerDayImmune>
        <immunityPerDayNotSick>-0.06</immunityPerDayNotSick>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
      </li>
    </comps>
    <stages>
      <!-- Phase 1: Days 1-3 (Severity 0.0 to 0.42) -->
      <li>
        <label>fever and madness</label>
        <painOffset>0.75</painOffset>
        <vomitMtbDays>0.2</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>WanderConfused</mentalState>
            <mtbDays>0.5</mtbDays>
          </li>
          <li>
            <mentalState>Berserk</mentalState>
            <mtbDays>1.0</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <!-- Phase 2: Days 4-7 (Severity 0.42+) -->
      <li>
        <minSeverity>0.42</minSeverity>
        <label>deep coma</label>
        <painOffset>0.2</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Trial of Dreams -->
  <HediffDef>
    <defName>Witcher_TrialOfDreams</defName>
    <label>Trial of Dreams</label>
    <description>The subject is exposed to powerful mutagens that force a psychic connection to the void. Requires constant monitoring.</description>
    <hediffClass>WitcherTrials.Hediff_TrialOfDreams</hediffClass>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.10</severityPerDayNotImmune>
        <immunityPerDaySick>0.12</immunityPerDaySick>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
      </li>
    </comps>
    <stages>
      <li>
        <label>visions</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.6</setMax>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>WanderConfused</mentalState>
            <mtbDays>1.0</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- Apex Mutations -->
  <HediffDef>
    <defName>Witcher_AdvancedMutationSickness</defName>
    <label>apex mutagenic shock</label>
    <description>The body is undergoing a cataclysmic restructuring due to highly concentrated apex mutagens. Extremely lethal without constant, high-quality medical tending.</description>
    <hediffClass>WitcherTrials.Hediff_ApexMutations</hediffClass>
    <defaultLabelColor>(0.9, 0.2, 0.2)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.80</severityPerDayNotImmune>
        <immunityPerDaySick>0.40</immunityPerDaySick>
        <severityPerDayImmune>-0.5</severityPerDayImmune>
        <immunityPerDayNotSick>-0.1</immunityPerDayNotSick>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>8</baseTendDurationHours>
        <severityPerDayTended>-0.25</severityPerDayTended>
      </li>
    </comps>
    <stages>
      <li>
        <label>fever</label>
        <painOffset>0.30</painOffset>
        <vomitMtbDays>0.2</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.7</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.40</minSeverity>
        <label>hemorrhaging</label>
        <painOffset>0.60</painOffset>
        <vomitMtbDays>0.1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.3</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.80</minSeverity>
        <label>mutagenic seizures</label>
        <painOffset>0.85</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>