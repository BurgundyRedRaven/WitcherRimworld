<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Base -->
    <HediffDef Name="WitcherPotionEffectBase" Abstract="True">
        <hediffClass>HediffWithComps</hediffClass>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay> <!-- Lasts 12 in-game hours by default -->
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
    </HediffDef>

    <!-- Swallow -->
    <HediffDef ParentName="WitcherPotionEffectBase">
        <defName>WitcherPotion_SwallowEffect</defName>
        <label>swallow (potion)</label>
        <description>Accelerated cellular regeneration.</description>
        <defaultLabelColor>(200, 50, 50)</defaultLabelColor>
        <stages>
            <li>
                <statFactors>
                    <InjuryHealingFactor>3.0</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <!-- Thunderbolt -->
    <HediffDef ParentName="WitcherPotionEffectBase">
        <defName>WitcherPotion_ThunderboltEffect</defName>
        <label>thunderbolt (potion)</label>
        <description>Muscular overdrive.</description>
        <defaultLabelColor>(50, 200, 50)</defaultLabelColor>
        <stages>
            <li>
                <statFactors>
                    <MeleeDamageFactor>1.50</MeleeDamageFactor>
                    <MeleeCooldownFactor>0.75</MeleeCooldownFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.40</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <!-- Tawny Owl -->
    <HediffDef ParentName="WitcherPotionEffectBase">
        <defName>WitcherPotion_TawnyOwlEffect</defName>
        <label>tawny owl (potion)</label>
        <description>Accelerated stamina regeneration.</description>
        <defaultLabelColor>(150, 50, 200)</defaultLabelColor>
        <stages>
            <li>
                <statFactors>
                    <RestFallRateFactor>0.20</RestFallRateFactor>
                    <WorkSpeedGlobal>1.40</WorkSpeedGlobal>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.30</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <!-- Petri's Philter -->
    <HediffDef ParentName="WitcherPotionEffectBase">
        <defName>WitcherPotion_PetrisPhilterEffect</defName>
        <label>petri's philter (potion)</label>
        <description>Amplified neural and psychic pathways.</description>
        <defaultLabelColor>(200, 200, 50)</defaultLabelColor>
        <stages>
            <li>
                <statFactors>
                    <PsychicSensitivity>1.50</PsychicSensitivity>
                    <PsychicEntropyRecoveryRate>1.50</PsychicEntropyRecoveryRate>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <!-- White Raffard -->
    <HediffDef ParentName="WitcherPotionEffectBase">
        <defName>WitcherPotion_WhiteRaffardEffect</defName>
        <label>white raffard (potion)</label>
        <description>Violent biological mending. Wounds seal rapidly over a brief period.</description>
        <defaultLabelColor>(255, 50, 50)</defaultLabelColor>
        <comps Inherit="False">
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-8.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="WitcherTrials.HediffCompProperties_StopBleeding" />
        </comps>
        <stages>
            <li>
                <statFactors>
                    <InjuryHealingFactor>25.0</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
</Defs>